🔥\",\n            windspeed_auto = \"Ventilateur: AUTO\",\n            windspeed_low = \"Ventilateur: BAS\",\n            windspeed_medium_low = \"Ventilateur: MOYEN BAS\",\n            windspeed_medium_hight = \"Ventilateur: MOYEN HAUT\",\n            windspeed_medium_high = \"Ventilateur: MOYEN HAUT\",\n            windspeed_hight = \"Ventilateur: HAUT\",\n            windspeed_high = \"Ventilateur: HAUT\",\n            windspeed_undefined = \"Ventilateur: Indéfini\",\n            lights_on = \"Lumière activée ✅\",\n            lights_off = \"Lumière désactivée ❌\",\n            quiet_on = \"Mode silencieux activé ✅\",\n            quiet_off = \"Mode silencieux désactivé ❌\",\n            energy_on = \"Économie d'énergie activée ✅\",\n            energy_off = \"Économie d'énergie désactivée ❌\",\n            swing_default = \"Balayage: Par défaut\",\n            swing_full = \"Balayage: Amplitude complète\",\n            swing_middle = \"Balayage: Position centrale fixe\",\n            swing_undefined = \"Balayage: Indéfini\",\n            hub_autodiscovery = \"Détection auto : ACTIVE\",\n            hub_ac_count = \"Climatiseurs sur le réseau : %d ✅\",\n            hub_scan_hint = \"Cliquez ci-dessous pour scanner le réseau\",\n            hub_scanning = \"Scan LAN en cours... 🔍\",\n            hub_found_count = \"Trouvés : %d | Total : %d ✅\",\n            hub_no_new = \"Aucun nouvel appareil détecté ⚠️\",\n            ac_device_prefix = \"Climatiseur \",\n            connecting = \"Connexion... ⏳\",\n            reconnecting_step = \"Connexion... 🔄 (#%d)\"\n        },\n        messages = {\n            pairing_timeout = \"Délai d'appairage dépassé ⏰\",\n            step1_failed = \"Étape 1 échouée ❌\",\n            step2_failed = \"Étape 2 échouée ❌\",\n            invalid_response = \"Réponse invalide ❌\",\n            decrypt_failed = \"Échec du déchiffrement ❌\",\n            missing_data = \"Données manquantes ❌\",\n            receive_error = \"Erreur de r